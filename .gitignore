# Local environments and secrets
.env
.env.*
!.env.example
!.env.sample
.venv/
venv/
node_modules/

# Python and notebook caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# macOS metadata and temporary Office files
.DS_Store
._*
~$*
.~lock.*#

# Local document and chart build intermediates
.build/
.chart-*/

# Submission archives duplicate the individual deliverables.
/deliverables/*.zip

# Keep result tables, figures and final documents versionable; omit run logs.
/outputs/*.log
/outputs/*_log.txt

# Local validation receipts
/outputs/validation/*

# This retained baseline is an input to source-integrity validation.
!/outputs/validation/protected_sources.json

# Study notes and local reading material, not deliverables
/notes/
Thirsty_Cloud_Beginners_Handbook.md
Thirsty_Cloud_Beginners_Handbook.pdf

# Third-party reports kept locally for context; they feed no number in the
# model or the paper and are not distributed (see data/manual/README.md)
/data/manual/operator_digitalrealty_2024.pdf
/data/manual/operator_equinix_2024.pdf
/data/manual/operator_keppeldc_2024.pdf
/data/manual/operator_sttgdc_2024.pdf
/data/manual/kit_ar_2024.pdf
/data/manual/lit_santos_2026.pdf
/data/manual/pub_annual_report_2026.pdf
